<?xml version="1.0" encoding="utf-8"?>
<!-- Power button while the unit is running: filled accent, so the button
     itself also signals state (not just its icon tint). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/widget_status_on_bg" />
    <corners android:radius="22dp" />
</shape>
