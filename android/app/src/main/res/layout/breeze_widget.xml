<?xml version="1.0" encoding="utf-8"?>
<!-- Single-unit widget. The root background, the status badge and the power
     button are all re-skinned per state by BreezeUnitWidgetProvider: colourful
     while the unit runs, neutral/colourless when it's off or unreachable. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/breeze_widget_bg_off"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:textStyle="bold"
            android:textSize="14sp"
            android:textColor="@color/widget_text_primary"
            android:text="@string/widget_label" />

        <!-- The state, spelled out. This is the fix for "I can't tell if it's on". -->
        <TextView
            android:id="@+id/widget_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/breeze_widget_status_off"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:textStyle="bold"
            android:textSize="12sp"
            android:letterSpacing="0.08"
            android:textColor="@color/widget_status_off_text"
            android:text="@string/widget_state_off" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="2dp">

        <TextView
            android:id="@+id/widget_temp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:textStyle="bold"
            android:textSize="34sp"
            android:textColor="@color/widget_text_primary"
            android:text="@string/widget_dash" />

        <TextView
            android:id="@+id/widget_mode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:maxLines="2"
            android:textSize="13sp"
            android:textColor="@color/widget_text_secondary"
            android:text="@string/widget_not_configured" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="10dp">

        <ImageButton
            android:id="@+id/widget_btn_power"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/breeze_widget_btn_bg"
            android:src="@drawable/ic_widget_power"
            android:scaleType="centerInside"
            android:padding="8dp"
            android:contentDescription="Power" />

        <ImageButton
            android:id="@+id/widget_btn_minus"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:background="@drawable/breeze_widget_btn_bg"
            android:src="@drawable/ic_widget_minus"
            android:scaleType="centerInside"
            android:padding="8dp"
            android:contentDescription="Lower temperature" />

        <ImageButton
            android:id="@+id/widget_btn_plus"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:background="@drawable/breeze_widget_btn_bg"
            android:src="@drawable/ic_widget_plus"
            android:scaleType="centerInside"
            android:padding="8dp"
            android:contentDescription="Raise temperature" />

        <ImageButton
            android:id="@+id/widget_btn_refresh"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:background="@drawable/breeze_widget_btn_bg"
            android:src="@drawable/ic_widget_refresh"
            android:scaleType="centerInside"
            android:padding="8dp"
            android:contentDescription="Refresh" />
    </LinearLayout>
</LinearLayout>
