<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Material You dynamic colours (API 31+, light). Pulled from the
         system wallpaper palette so the widget matches the launcher. -->
    <color name="widget_background">@android:color/system_neutral1_50</color>
    <color name="widget_text_primary">@android:color/system_neutral1_900</color>
    <color name="widget_text_secondary">@android:color/system_neutral2_700</color>
    <color name="widget_button_bg">@android:color/system_accent1_100</color>
    <color name="widget_icon">@android:color/system_accent1_900</color>
    <color name="widget_accent">@android:color/system_accent1_600</color>

    <!-- On/off skin: ON borrows the wallpaper accent (colourful), OFF falls
         back to the neutral ramp (colourless). -->
    <color name="widget_bg_on">@android:color/system_accent1_100</color>
    <color name="widget_bg_off">@android:color/system_neutral1_100</color>
    <color name="widget_status_on_bg">@android:color/system_accent1_600</color>
    <color name="widget_status_on_text">@android:color/system_accent1_0</color>
    <color name="widget_status_off_bg">@android:color/system_neutral2_200</color>
    <color name="widget_status_off_text">@android:color/system_neutral1_700</color>
    <color name="widget_text_muted">@android:color/system_neutral2_700</color>
</resources>
